# ==========================================
# TourDZ (Airbnb Clone) - Environment Variables
# ==========================================

# 1. Clerk Authentication
# Get these from your Clerk Dashboard (https://dashboard.clerk.com/)
# The publishable key is needed by the frontend (Expo).
# The secret key is needed if you build a backend (Node.js/Next.js).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# 2. Google Maps API (Optional but recommended for iOS)
# React Native Maps uses Google Maps by default on Android, but Apple Maps on iOS.
# To force Google Maps on iOS, you need an API key from Google Cloud Console.
# Get it here: https://console.cloud.google.com/
# Make sure to enable the "Maps SDK for iOS" API.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...

# 3. Database / Backend (Future Use)
# If we connect this to a real backend like Supabase or Firebase, you'll put those keys here.
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
